{
  "uid": "iot-ta3",
  "title": "IoT TA3 - Sensores Raspberry Pi",
  "tags": [
    "iot",
    "mqtt",
    "ta3"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
