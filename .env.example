# ── Broker EMQX ───────────────────────────────────────────────
# Usuario y contraseña del dashboard (http://localhost:18083).
# Solo se aplican al primer arranque con el volumen vacío.
# La contraseña debe tener 8 a 64 caracteres y mezclar letras y números.
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=cambia-esta-clave-1

# ── Credenciales MQTT (nodo Python y Telegraf) ────────────────
# Deben coincidir con el usuario creado en EMQX (Fase 3 del SKILL.md).
MQTT_USERNAME=iot_node
MQTT_PASSWORD=cambia-esta-clave-2

# ── Nodo IoT (Python, se ejecuta en el host) ──────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_BASE=iot/raspberrypi
DEVICE_ID=raspberrypi-01
PUBLISH_INTERVAL_SECONDS=5

# ── InfluxDB ──────────────────────────────────────────────────
# Si cambias la organización, el bucket sigue siendo "iot" (ver telegraf.conf).
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=cambia-esta-clave-3
INFLUX_ORG=utp
INFLUX_TOKEN=cambia-este-token-largo-y-aleatorio

# ── Grafana (http://localhost:3000) ───────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia-esta-clave-4
